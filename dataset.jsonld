  "distribution": [
    {
      "@type": "DataDownload",
      "encodingFormat": "application/json",
      "contentUrl": "https://raw.githubusercontent.com/greatsong/k-curriculum-2022/v3.0.1/data/standards.json"
    },
    {
      "@type": "DataDownload",
      "encodingFormat": "text/csv",
      "contentUrl": "https://raw.githubusercontent.com/greatsong/k-curriculum-2022/v3.0.1/data/standards.csv"
    }
  ],
  "variableMeasured": [
    {
      "@type": "PropertyValue",
      "name": "key",
      "description": "고유 식별자. 기본은 code와 같고, 같은 code가 두 과목에 쓰인 11건만 \"code|subject\" 형식 / Unique identifier; equals code except for 11 code collisions, where it is \"code|subject\""
    },
    {
      "@type": "PropertyValue",
      "name": "code",
      "description": "교육부 고시의 성취기준 코드, 원문 표기 그대로 / Achievement-standard code as printed in the MOE notice"
    },
    {
      "@type": "PropertyValue",
      "name": "subject_group",
      "description": "교과군 (20종) / Subject group (20)"
    },
    {
      "@type": "PropertyValue",
      "name": "subject",
      "description": "과목 (292종) / Subject (292)"
    },
    {
      "@type": "PropertyValue",
      "name": "school_level",
      "description": "초등학교·중학교·고등학교. 산업수요 전문교과는 빈 문자열 / Elementary, middle, high; empty for industry-demand vocational subjects"
    },
    {
      "@type": "PropertyValue",
      "name": "grade_group",
      "description": "학년군: 초1-2·초3-4·초5-6·중1-3·고공통·고선택·기타 / Grade band"
    },
    {
      "@type": "PropertyValue",
      "name": "curriculum_category",
      "description": "공통·일반선택·진로선택·융합선택·선택·전문공통·전공일반·전공실무 / Curriculum category"
    },
    {
      "@type": "PropertyValue",
      "name": "area",
      "description": "원문의 성취기준 소제목(영역) / Content area heading from the source"
    },
    {
      "@type": "PropertyValue",
      "name": "content",
      "description": "성취기준 본문, 고시 원문 verbatim / Standard text, verbatim from the notice"
    },
    {
      "@type": "PropertyValue",
      "name": "keywords",
      "description": "본문 앞 어절을 단순 분리한 값(CSV에서는 ; 구분). 검색 보조용 / Naive tokens from the text (; separated in CSV); search aid only"
    },
    {
      "@type": "PropertyValue",
      "name": "explanation",
      "description": "성취기준 해설, 원문에 있는 경우(71%) / Official explanation when present (71%)"
    },
    {
      "@type": "PropertyValue",
      "name": "application_notes",
      "description": "영역 단위 \"성취기준 적용 시 고려사항\", 불릿마다 • 접두 / Area-level application notes, bullets prefixed with •"
    },
    {
      "@type": "PropertyValue",
      "name": "source_book",
      "description": "이 행이 실린 교육부 고시 별책 번호(예: 별책8) / MOE notice appendix number this row was extracted from (e.g. 별책8)"
    },
    {
      "@type": "PropertyValue",
      "name": "source_doc",
      "description": "원문 파일 제목(예: [별책8] 수학과 교육과정(2022 개정)) — NCIC에서 같은 제목으로 열람 / Title of the source document; look it up on NCIC by this title"
    }
  ],
  "copyrightNotice": "성취기준 원문은 교육부 고시 제2022-33호의 내용으로 저작권법 제7조 제2호(국가의 고시)에 따라 보호받지 못하는 저작물로 이해합니다. CC BY 4.0은 이 저장소가 더한 구조화·식별자·출처·메타데이터에 적용됩니다. / Source text is the content of MOE Notice No. 2022-33, understood as a non-protected state notice under Art. 7(2) of the Korean Copyright Act; CC BY 4.0 applies to the structuring, identifiers, provenance and metadata added here.",
  "creditText": "Source: Ministry of Education Notice No. 2022-33 (2022 Revised National Curriculum) via NCIC https://ncic.re.kr · Dataset: k-curriculum-2022 (greatsong), CC BY 4.0"
